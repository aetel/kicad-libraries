(footprint "MY-2032-08-J-Fe" (version 20240108) (generator "pcbnew")
  (layer "F.Cu")
  (descr "MY-2032-08-J-Fe CR2032 SMT battery holder. Dimensions taken from supplied mechanical drawing. Verify pad polarity against the physical part before fabrication.")
  (tags "CR2032 battery holder SMT")
  (attr smd)

  (fp_text reference "REF**" (at 0 -9.2) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "MY-2032-08-J-Fe" (at 0 9.2) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )

  ; Approximate plastic-holder outline on fabrication layer.
  (fp_line (start -8.0 -7.6) (end 8.0 -7.6) (stroke (width 0.10) (type default)) (layer "F.Fab"))
  (fp_line (start 8.0 -7.6) (end 10.0 -5.6) (stroke (width 0.10) (type default)) (layer "F.Fab"))
  (fp_line (start 10.0 -5.6) (end 10.0 5.6) (stroke (width 0.10) (type default)) (layer "F.Fab"))
  (fp_line (start 10.0 5.6) (end 8.0 7.6) (stroke (width 0.10) (type default)) (layer "F.Fab"))
  (fp_line (start 8.0 7.6) (end -8.0 7.6) (stroke (width 0.10) (type default)) (layer "F.Fab"))
  (fp_line (start -8.0 7.6) (end -10.0 5.6) (stroke (width 0.10) (type default)) (layer "F.Fab"))
  (fp_line (start -10.0 5.6) (end -10.0 -5.6) (stroke (width 0.10) (type default)) (layer "F.Fab"))
  (fp_line (start -10.0 -5.6) (end -8.0 -7.6) (stroke (width 0.10) (type default)) (layer "F.Fab"))

  ; Simplified silkscreen outline, kept clear of the SMT pads.
  (fp_line (start -7.8 -7.8) (end 7.8 -7.8) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  (fp_line (start 7.8 -7.8) (end 9.8 -5.8) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  (fp_line (start 9.8 -5.8) (end 9.8 5.8) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  (fp_line (start 9.8 5.8) (end 7.8 7.8) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  (fp_line (start 7.8 7.8) (end -7.8 7.8) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  (fp_line (start -7.8 7.8) (end -9.8 5.8) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  (fp_line (start -9.8 5.8) (end -9.8 -5.8) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  (fp_line (start -9.8 -5.8) (end -7.8 -7.8) (stroke (width 0.12) (type default)) (layer "F.SilkS"))

  ; Courtyard: approximate overall envelope 23.5 x 15.2 mm plus clearance.
  (fp_rect (start -12.25 -8.1) (end 12.25 8.1)
    (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))

  ; PCB layout drawing: two side contacts, each 1.75 x 5.60 mm.
  ; Pad numbering/polarity is provisional; confirm with manufacturer or continuity test.
  (pad "1" smd rect (at -10.875 0) (size 1.75 5.60) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "2" smd rect (at 10.875 0) (size 1.75 5.60) (layers "F.Cu" "F.Paste" "F.Mask"))  

  (model "${KICAD_3DMODEL_DIR}/AETEL.3dshapes/MY-2032-08-J-Fe.step"
    (offset (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
